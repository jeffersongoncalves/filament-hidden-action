includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: false
    ignoreErrors:
        # The package's namespaced view is not registered during analysis, so Larastan cannot prove view-string.
        -
            identifier: argument.type
            message: '#expects Closure\|view-string\|null, .+ given#'
            path: src/HiddenAction.php
